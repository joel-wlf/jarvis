{
  "name": "mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:contract && tsc",
    "build:contract": "tsc -p ../packages/contract",
    "start": "node dist/index.js",
    "check": "npm run build:contract && tsc --noEmit && tsc --noEmit -p test",
    "test": "npm run build:contract && node --import tsx --test --test-concurrency=1 'test/*.test.ts'"
  },
  "dependencies": {
    "@jarvis/contract": "file:../packages/contract",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-pgvector": "^0.0.11",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
