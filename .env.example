# Kopieren nach .env und Werte setzen. Zufallswerte erzeugen mit: openssl rand -hex 24
# Nur Buchstaben/Zahlen verwenden (hex ist ideal), keine Sonderzeichen.
POSTGRES_PASSWORD=
MCP_RO_PASSWORD=
# Geheimer Token für den MCP-Server (siehe README: Bearer-Header oder /t/<token>/mcp)
MCP_TOKEN=
# Token des Cloudflare Tunnels (Zero Trust -> Networks -> Tunnels -> Token).
# Danach zusätzlich COMPOSE_PROFILES=tunnel setzen, damit der Tunnel mitstartet.
CLOUDFLARE_TUNNEL_TOKEN=
#COMPOSE_PROFILES=tunnel

# OpenAI: Sprachnachrichten-Transkription und Embeddings (Bedeutungssuche). Ohne Schlüssel läuft alles lokal (langsam, heizt den Pi).
# WICHTIG: Vor dem ersten Start mit Schlüssel ORGANIZER_EXCLUDE_NAMES setzen, sonst gehen auch sensible Chats an OpenAI.
OPENAI_API_KEY=
#OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
#OPENAI_EMBED_MODEL=text-embedding-3-small

# Lokale Transkription (Fallback, nur mit COMPOSE_PROFILES=local-whisper)
# Modell: base | small | medium (wird beim Build geladen)
WHISPER_MODEL=small
# Sprache: de, en, ... oder auto
WHISPER_LANG=de

# Schreib-Aktionen (Nachrichten senden, abstimmen, reagieren)
# false = MCP-Server ist rein lesend
ENABLE_ACTIONS=true
# Obergrenze für Aktionen pro Stunde (Schutz vor Missbrauch/Sperre)
MAX_ACTIONS_PER_HOUR=30

# Themen-Sortierung per OpenAI-API (gleicher OPENAI_API_KEY wie oben; COMPOSE_PROFILES=organizer oder tunnel,organizer setzen)
ORGANIZER_ENABLED=false
# Modell (günstig, strukturierte Ausgabe nötig). Preise für die Kostenschätzung in $ pro Mio Token:
#ORGANIZER_MODEL=gpt-4.1-mini
#ORGANIZER_PRICE_IN=0.4
#ORGANIZER_PRICE_OUT=1.6
# Chats, deren Name einen dieser Begriffe enthält, werden NIE an die KI geschickt (kommagetrennt), z.B. Arzt,Bank,Anwalt
ORGANIZER_EXCLUDE_NAMES=
# Obergrenze Eingabe+Ausgabe-Token pro Tag
ORGANIZER_DAILY_TOKEN_BUDGET=3000000
# Telefonnummern, IBANs, E-Mails und Link-Pfade vor dem Senden schwärzen
ORGANIZER_REDACT=true

# Verknüpfen per Kopplungscode statt QR (Telefonnummer mit Ländervorwahl, nur Ziffern, z.B. 4915112345678). Nach dem Verknüpfen wieder leeren.
WA_PAIRING_PHONE=

# Bildbeschreibung (Vision) für alle Bilder, braucht OPENAI_API_KEY. IMAGE_DETAIL: low (billiger) | auto | high (liest Text besser)
#IMAGE_DESCRIBE=true
#IMAGE_MODEL=gpt-4.1-mini
#IMAGE_DETAIL=auto
