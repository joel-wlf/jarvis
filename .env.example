# Jarvis-Einstellungen. Am einfachsten über die Admin-Oberfläche einrichten:
#   docker compose up -d admin   und dann http://<adresse-des-pi>:8080 öffnen
# Von Hand: nach .env kopieren und mindestens die Pflichtwerte setzen. Zufallswerte: openssl rand -hex 24
# Diese Datei wird erzeugt (cd admin && npm run gen-env-example), bitte admin/src/schema.ts ändern.

# ===== Allgemein =====
# Dein Name: So spricht Jarvis in Anweisungen, Zusammenfassungen und Profilen von dir. Leer = „dich".
#OWNER_NAME=
# Weitere eigene Namen: Spitznamen oder Schreibweisen, mit denen andere dich ansprechen. Werden nie als Name einer anderen Person übernommen. Leer = nur dein Name.
#OWN_NAMES=

# ===== Zugang & Fernzugriff =====
# MCP-Token (Pflicht): Geheimer Schlüssel in der Connector-URL für Claude. Wer ihn hat, kann deine Chats lesen und in deinem Namen schreiben. Wechseln macht die alte URL sofort ungültig.
MCP_TOKEN=
# Öffentlicher Hostname: Der Hostname, den du im Cloudflare-Tunnel für den MCP-Server eingetragen hast. Nur für die Anzeige der Connector-URL.
#MCP_PUBLIC_HOST=
# Cloudflare-Tunnel-Token: Macht den MCP-Server von außen erreichbar (Zero Trust → Networks → Tunnels). Gesetzt = Tunnel läuft. Den ganzen Installationsbefehl einfügen geht auch.
#CLOUDFLARE_TUNNEL_TOKEN=
# Datenbank-Passwort (Pflicht): Hauptpasswort der Datenbank. Gilt nur beim allerersten Start; später nur über „Wechseln", das die Datenbank mit umstellt.
POSTGRES_PASSWORD=
# Passwort der MCP-Datenbankrollen (Pflicht): Für die eingeschränkten Rollen mcp_ro, mcp_act und mcp_mem. Ändern nur über „Wechseln".
MCP_RO_PASSWORD=

# ===== KI-Anbieter =====
# OpenAI-API-Schlüssel: Optional. Ohne Schlüssel läuft alles lokal (langsam, heizt den Pi) und es gibt keine Themen-Sortierung und keine Bildbeschreibung.
#OPENAI_API_KEY=
# API-Adresse: Für OpenAI-kompatible Anbieter oder einen Proxy. Gilt für Themen-Sortierung und Bildbeschreibung.
#OPENAI_BASE_URL=https://api.openai.com/v1

# ===== Datenschutz =====
# Chats nie an die KI senden: Chats, deren Name einen dieser Begriffe enthält, gehen weder an die Embedding- noch an die Sortier-API. Unbedingt vor dem ersten Start mit Schlüssel setzen.
#ORGANIZER_EXCLUDE_NAMES=
# Persönliche Daten schwärzen: Telefonnummern, IBANs, E-Mail-Adressen und Link-Pfade vor dem Senden an die KI entfernen.
#ORGANIZER_REDACT=true
# Personen-Profile ohne Details: Profile nur allgemein halten (keine konkreten Angaben wie Orte oder Ereignisse).
#PEOPLE_SCRUB=false

# ===== Sprachnachrichten =====
# Transkription: Automatisch = OpenAI, wenn ein Schlüssel gesetzt ist, sonst lokal. Lokal startet whisper.cpp (langsam, ~1,5 GB RAM). Werte: (leer) | openai | local | off.
#TRANSCRIBE_PROVIDER=
# OpenAI-Modell: Modell für die Transkription bei OpenAI.
#OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Lokales Modell: Größer = genauer, aber langsamer und mehr Speicher. Wird beim Bauen geladen (Änderung baut whisper neu). Werte: base | small | medium.
#WHISPER_MODEL=small
# Sprache: Sprachcode wie de oder en, oder auto.
#WHISPER_LANG=de
# Ältere Sprachnachrichten: Nur Sprachnachrichten bis zu diesem Alter transkribieren. Leer = automatisch (OpenAI: alle, lokal: 14 Tage).
#TRANSCRIBE_MAX_AGE_DAYS=
# Maximale Länge: Längere Sprachnachrichten werden übersprungen.
#MAX_AUDIO_SECONDS=600

# ===== Bilder =====
# Bilder beschreiben: Beschreibt jedes Bild per KI, damit es durchsuchbar wird. Braucht einen OpenAI-Schlüssel.
#IMAGE_DESCRIBE=true
# Modell: Vision-fähiges Modell.
#IMAGE_MODEL=gpt-4.1-mini
# Detailstufe: low ist billiger, liest aber kaum Text in Screenshots. Werte: low | auto | high.
#IMAGE_DETAIL=auto
# Gleichzeitige Anfragen: Wie viele Bilder parallel beschrieben werden.
#IMAGE_CONCURRENCY=3

# ===== Suche =====
# Embeddings: Automatisch = OpenAI mit Schlüssel, sonst lokal. Ein Wechsel berechnet alle Vektoren neu (dauert, kostet bei OpenAI). Werte: (leer) | openai | local.
#EMBED_PROVIDER=
# OpenAI-Modell: Wird auf 384 Dimensionen gekürzt.
#OPENAI_EMBED_MODEL=text-embedding-3-small
# Stapelgröße: Nachrichten pro Durchgang. Leer = automatisch (OpenAI 100, lokal 32).
#EMBED_BATCH=
# Themen-Trefferschwelle: Maximale Vektor-Distanz, ab der ein Thema in der Suche noch als passend gilt. Kleiner = strenger.
#SEARCH_MAX_TOPIC_DIST=0.52

# ===== Themen-Sortierung =====
# Themen-Sortierung aktiv: Startet den Organizer. Braucht einen OpenAI-Schlüssel. Kosten vorab unter Wartung → Kostenschätzung prüfen.
#ORGANIZER_ENABLED=false
# Modell: Günstiges Modell mit strukturierter Ausgabe.
#ORGANIZER_MODEL=gpt-4.1-mini
# Reasoning-Aufwand: Nur für Reasoning-Modelle. Werte: (leer) | minimal | low | medium | high.
#ORGANIZER_REASONING_EFFORT=
# Tagesbudget: Obergrenze Eingabe + Ausgabe pro Tag. Danach pausiert die Sortierung bis morgen.
#ORGANIZER_DAILY_TOKEN_BUDGET=3000000
# Preis Eingabe: Für die Kostenschätzung. Aktuellen Preis auf der Seite des Anbieters prüfen.
#ORGANIZER_PRICE_IN=0.4
# Preis Ausgabe: Für die Kostenschätzung.
#ORGANIZER_PRICE_OUT=1.6
# Ruhezeit: Jüngere Nachrichten warten, bis das Gespräch ruht.
#ORGANIZER_SETTLE_HOURS=1
# Mindestanzahl: Ab so vielen unsortierten Nachrichten wird ein Chat sortiert …
#ORGANIZER_MIN_MESSAGES=4
# Maximale Wartezeit: … oder wenn die älteste so lange wartet.
#ORGANIZER_MAX_WAIT_HOURS=12
# Pause zwischen Durchläufen: Wartezeit, wenn nichts zu tun ist.
#ORGANIZER_IDLE_MINUTES=2
# Nachrichten pro Aufruf: Obergrenze je KI-Aufruf.
#ORGANIZER_MAX_MESSAGES=150
# Zeichen pro Aufruf: Obergrenze je KI-Aufruf.
#ORGANIZER_MAX_CHARS=30000
# Thema veraltet nach: Offenes Thema ohne Termin und ohne Aktivität gilt danach als veraltet.
#TOPIC_STALE_DAYS=21
# Thema vorbei nach Termin: So lange nach dem Termin bleibt ein Thema noch offen.
#TOPIC_PAST_GRACE_HOURS=24

# ===== Personen-Profile =====
# Mindestnachrichten im Chat: Erst ab so vielen Nachrichten im Einzelchat wird ein Profil erstellt.
#PEOPLE_MIN_MESSAGES=30
# Davon von der Person: Mindestens so viele Nachrichten müssen von der anderen Person sein.
#PEOPLE_MIN_THEIRS=8
# Neubewertung frühestens nach: Ein Profil wird höchstens so oft neu eingeschätzt.
#PEOPLE_MIN_INTERVAL_DAYS=14
# KI-Aufrufe pro Tag: Obergrenze für Personen-Einschätzungen pro Tag.
#PEOPLE_MAX_PER_DAY=60
# Neu bei Wachstum um Faktor: 1,2 = Chat um 20 % gewachsen.
#PEOPLE_REFRESH_GROWTH=1.2
# Neu bei Gruppenänderung: Gemeinsame Gruppen um so viele geändert.
#PEOPLE_GROUP_DELTA=3
# Neu bei Aktivitätsänderung: Mindeständerung der Nachrichten der letzten 90 Tage.
#PEOPLE_ACTIVITY_DELTA=15

# ===== Aktionen & Gedächtnis =====
# Aktionen erlauben: Senden, Abstimmen, Reagieren, Gruppen verwalten. Aus = der MCP-Server ist rein lesend.
#ENABLE_ACTIONS=true
# Erst Vorschau, dann ausführen: An: jede Aktion zeigt erst eine Vorschau und läuft erst mit confirm=true. Aus: Aktionen laufen sofort.
#REQUIRE_CONFIRM=false
# Aktionen pro Stunde: Schutz vor Missbrauch und WhatsApp-Sperre. Abfragen zählen nicht mit.
#MAX_ACTIONS_PER_HOUR=30
# Gedächtnis & Korrekturen: Notizen, Erinnerungen, Personen- und Themenkorrekturen speichern.
#ENABLE_MEMORY=true

# ===== WhatsApp =====
# Kopplung per Telefonnummer: Statt QR-Code: Nummer mit Ländervorwahl (z.B. 4915112345678). Wird nach erfolgreicher Verknüpfung automatisch geleert.
#WA_PAIRING_PHONE=

# ===== Oberfläche =====
# Port: Port dieser Seite auf dem Pi.
#ADMIN_PORT=8080
# Erreichbar über: 0.0.0.0 = im ganzen Heimnetz, 127.0.0.1 = nur auf dem Pi selbst (Zugriff per SSH-Tunnel).
#ADMIN_BIND=0.0.0.0
# Ordner der echten .env (Tresor): Nur mit verschlüsseltem Tresor: Ordner, auf den ~/jarvis/.env verweist (z.B. /srv/vault/secrets).
#JARVIS_SECRETS_DIR=.

# ===== Experten =====
# Log-Stufe wa-ingest: debug für Fehlersuche, sonst info. Werte: fatal | error | warn | info | debug | trace.
#LOG_LEVEL=info
# Log-Stufe WhatsApp-Bibliothek: Sehr gesprächig ab info. Werte: fatal | error | warn | info | debug | trace.
#BAILEYS_LOG_LEVEL=warn

# Docker-Profile (tunnel, organizer, local-whisper). Die Oberfläche setzt sie automatisch passend.
#COMPOSE_PROFILES=
